# Proyecto Supabase de Plexiacril. Las dos variables son públicas a propósito: la
# clave publicable viaja al navegador y lo que protege los datos es la RLS, no
# esconderla.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Quote Agent API (asistente de cotizaciones en /cotizaciones/asistente). Este sí es un
# secreto de servidor de verdad: no lo prefijes con NEXT_PUBLIC_ ni lo leas
# desde un archivo "use client".
AGENT_API_BASE_URL=http://127.0.0.1:8000
APP_API_KEY=

# Motor CAD (herramienta de diseños en /disenos): el servicio Python de `cad/`.
# Solo lo llama el servidor (`lib/cad/motor.ts`), así que nada de NEXT_PUBLIC_.
# En local el motor puede arrancar sin clave y entonces CAD_API_KEY va vacía.
CAD_API_BASE_URL=http://localhost:8000
CAD_API_KEY=

# Odoo, para las cotizaciones (/cotizaciones): buscar clientes y productos y
# crear allí cada cotización. Los mismos nombres que el otro proyecto de la
# empresa. Secretos de servidor de verdad —con ellos se crean clientes y
# cotizaciones—, así que nada de NEXT_PUBLIC_.
#
# ODOO_USERNAME es el login del usuario (casi siempre su correo).
# ODOO_PASSWORD acepta su contraseña o una API key suya: Odoo admite las dos. La
# API key es lo recomendable (se revoca sin tocar la contraseña, y es obligatoria
# si el usuario tiene verificación en dos pasos). Se genera en Odoo:
# Preferencias del usuario → Seguridad de la cuenta → Nueva clave API. Ese
# usuario necesita permisos de Ventas (crear cotizaciones) y de Contactos.
ODOO_URL=https://<empresa>.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# Solo para los tests de punta a punta.
# E2E_URL=http://localhost:3000
# E2E_PASSWORD=

# Avisos push. Solo va la mitad PÚBLICA del par VAPID: identifica a este servidor
# ante el servicio de push y viaja al navegador a propósito. La privada, que es la
# que firma, no está aquí ni puede estarlo — vive en los secretos de la Edge
# Function `enviar-push`, junto con la clave de servicio que lee las suscripciones
# de otras personas. Ese es el motivo de que el envío no lo haga Next.
# La imprime `generate-vapid-keys` (ver README). Sin ella el botón no se muestra.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
