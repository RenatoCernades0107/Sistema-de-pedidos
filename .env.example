# Proyecto Supabase de Plexiacril. Las dos variables son públicas a propósito: la
# clave publicable viaja al navegador y lo que protege los datos es la RLS, no
# esconderla. No hay ningún secreto de servidor que añadir.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

