# Proyecto Supabase de Plexiacril. Las dos variables son públicas a propósito: la
# clave publicable viaja al navegador y lo que protege los datos es la RLS, no
# esconderla.
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Quote Agent API (asistente de cotizaciones en /cotizaciones/asistente). Este sí es un
# secreto de servidor de verdad: no lo prefijes con NEXT_PUBLIC_ ni lo leas
# desde un archivo "use client".
AGENT_API_BASE_URL=http://127.0.0.1:8000
APP_API_KEY=

# Motor CAD (herramienta de diseños en /disenos): el servicio Python de `cad/`.
# Solo lo llama el servidor (`lib/cad/motor.ts`), así que nada de NEXT_PUBLIC_.
# En local el motor puede arrancar sin clave y entonces CAD_API_KEY va vacía.
# Puerto 8001 porque el agente de cotizaciones ya usa el 8000 en local.
CAD_API_BASE_URL=http://localhost:8001
CAD_API_KEY=

# Diseño libre (/disenos): cuando ninguna plantilla sirve, el asistente escribe
# código build123d que corre en el sandbox de `cad/sandbox/` (servicio aparte,
# sin red ni credenciales). Apagado salvo CAD_DISENO_LIBRE=1 Y sandbox configurado.
# En local: cd cad && uv run uvicorn sandbox.api:app --port 8002
CAD_DISENO_LIBRE=0
# En AWS: el output SandboxUrl (no MotorUrl). `curl <url>/salud` debe decir "servicio":"sandbox".
CAD_SANDBOX_BASE_URL=http://localhost:8002
CAD_SANDBOX_API_KEY=

# LLM del chat de diseños, por Inferhub. Solo en el servidor (`lib/llm/inferhub.ts`).
# La URL base y el formato (compatible con OpenAI) están por confirmar contra su
# documentación. Sin la clave, el chat avisa de que no está configurado.
INFERHUB_API_KEY=
INFERHUB_BASE_URL=https://inferhub.dev/v1
INFERHUB_MODELO=ag/claude-opus-5-5
# Si el modelo está saturado (sin cuota, límite de peticiones, sin conexión), el chat
# pasa enseguida al siguiente de INFERHUB_MODELOS_RESPALDO (separados por coma; sin la
# variable, ag/claude-sonnet-5-5; vacía, ninguno). INFERHUB_REINTENTOS (0 por defecto,
# máx. 5) repite antes con el mismo modelo, con pausas de 2 s, 5 s y 10 s.
INFERHUB_REINTENTOS=0
INFERHUB_MODELOS_RESPALDO=ag/claude-sonnet-5-5
# Cuánto razona el modelo en el chat (su "pensamiento" se ve en vivo): low, medium o high.
# Más esfuerzo = más tokens de salida. "off" no envía el parámetro y queda el valor por defecto
# del modelo (con claude-opus-5-5 el pensamiento no se puede apagar: razona igual, en medium).
INFERHUB_RAZONAMIENTO=medium
# Los PDF adjuntos al chat de diseños: `archivo` (por defecto) le manda al modelo
# el PDF entero (lee texto y dibujos); `texto` solo el texto que saca la app, por
# si la pasarela no acepta partes `file` (sin dibujos; los escaneados quedan sin leer).
INFERHUB_PDF=archivo

# Odoo, para las cotizaciones (/cotizaciones): buscar clientes y productos y
# crear allí cada cotización. Los mismos nombres que el otro proyecto de la
# empresa. Secretos de servidor de verdad —con ellos se crean clientes y
# cotizaciones—, así que nada de NEXT_PUBLIC_.
#
# ODOO_USERNAME es el login del usuario (casi siempre su correo).
# ODOO_PASSWORD acepta su contraseña o una API key suya: Odoo admite las dos. La
# API key es lo recomendable (se revoca sin tocar la contraseña, y es obligatoria
# si el usuario tiene verificación en dos pasos). Se genera en Odoo:
# Preferencias del usuario → Seguridad de la cuenta → Nueva clave API. Ese
# usuario necesita permisos de Ventas (crear cotizaciones) y de Contactos.
ODOO_URL=https://<empresa>.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=

# Solo para los tests de punta a punta.
# E2E_URL=http://localhost:3000
# E2E_PASSWORD=

# Avisos push. Solo va la mitad PÚBLICA del par VAPID: identifica a este servidor
# ante el servicio de push y viaja al navegador a propósito. La privada, que es la
# que firma, no está aquí ni puede estarlo — vive en los secretos de la Edge
# Function `enviar-push`, junto con la clave de servicio que lee las suscripciones
# de otras personas. Ese es el motivo de que el envío no lo haga Next.
# La imprime `generate-vapid-keys` (ver README). Sin ella el botón no se muestra.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clave con la que el servidor traduce un usuario a su correo al iniciar sesión (y al
# pedir "olvidé mi contraseña"). Debe coincidir con la fila 'login' de la tabla
# `secretos_app` en Supabase (ver README). Secreto de servidor: nada de NEXT_PUBLIC_.
# En local (npm run dev) puede quedar vacía: se usa plexi-login-dev-secreto, la que pone
# supabase/seed.sql. En producción es obligatoria; sin ella el login falla cerrado.
LOGIN_SECRET=

# Despliegue del motor y el sandbox en AWS (npm run aws:deploy [-- --stage dev]).
# Copia este bloque a .env.prod (o .env.dev): el stage elige el archivo. Ver cad/README.md.
# Las subredes deben ser PRIVADAS sin ruta a NAT/IGW y el security group sin reglas de salida.
CAD_AWS_REGION=us-east-1
CAD_AWS_PROFILE=
CAD_SANDBOX_SUBNET_A=
CAD_SANDBOX_SUBNET_B=
CAD_SANDBOX_SG=
